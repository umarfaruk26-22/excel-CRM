# Application Settings
APP_NAME="Customer Follow-up CRM"
APP_ENV=development
SECRET_KEY=crm-super-secret-key-change-this-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
TIMEZONE=Asia/Kolkata
REMINDER_ADVANCE_DAYS=5

# Database Settings (XAMPP Default)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=customer_followup_crm

# File Upload Settings
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=storage/uploads
ERROR_REPORT_DIR=storage/import-errors
EXPORT_DIR=storage/exports
